#. Plugin Name of the plugin
#: gp-elements-page-conditions.php
msgid "GP Elements Page Conditions"
msgstr "GP Elements Page Conditions"

#. Plugin URI of the plugin
#. Author URI of the plugin
#: gp-elements-page-conditions.php
msgid "https://headwall-hosting.com/"
msgstr "https://headwall-hosting.com/"

#. Description of the plugin
#: gp-elements-page-conditions.php
msgid "Adds a paging condition to GeneratePress Elements, so an Element can be shown only on page one of a paginated view, hidden from page one, or limited to specific page numbers."
msgstr "Aggiunge una condizione di impaginazione a GeneratePress Elements, in modo che un elemento possa essere visualizzato solo nella prima pagina di una vista impaginata, nascosto a partire dalla prima pagina oppure limitato a numeri di pagina specifici."

#. Author of the plugin
#: gp-elements-page-conditions.php
msgid "Paul Faulkner"
msgstr "Paul Faulkner"

#: admin-templates/element-meta-box.php:22
msgid "Applies on top of the display rules above, wherever pagination is in play: term and post type archives, the blog index, search results and multi-page posts."
msgstr "Si applica in aggiunta alle regole di visualizzazione sopra indicate, ovunque sia presente l'impaginazione: archivi per tag e tipi di post, indice del blog, risultati di ricerca e post su più pagine."

#: admin-templates/element-meta-box.php:46
msgctxt "field label; pages of a paginated archive"
msgid "Page numbers"
msgstr "Numeri di pagina"

#: functions-private.php:23
msgctxt "paging condition; apply no page restriction"
msgid "Pass through"
msgstr "Passaggio diretto"

#: functions-private.php:24
msgctxt "paging condition"
msgid "Only show on page one"
msgstr "Mostra solo nella prima pagina"

#: functions-private.php:25
msgctxt "paging condition"
msgid "Never show on page one"
msgstr "Non visualizzare mai in prima pagina"

#: functions-private.php:26
msgctxt "paging condition; followed by a list of page numbers"
msgid "Only show on pages…"
msgstr "Mostra solo nelle pagine…"

#: includes/class-meta-box.php:26
msgctxt "meta box title; pagination of an archive"
msgid "Paging Condition"
msgstr "Condizione di impaginazione"

#. translators: 1: this plugin's name, 2: the name of the plugin it depends on
#: includes/class-plugin.php:99
#, php-format
msgid "%1$s needs the Elements module of %2$s, which does not appear to be active. The plugin is doing nothing until it is."
msgstr "%1$s richiede il modulo Elements di %2$s, che non sembra essere attivo. Il plugin non esegue alcuna operazione finché il modulo non viene attivato."

#. translators: 1: single page example, 2: closed range example, 3: open range example, 4: open range example. All four are literal syntax and must not be translated.
#: admin-templates/element-meta-box.php:67
#, php-format
msgid "Comma separated. Accepts single pages (%1$s), ranges (%2$s) and open ranges (%3$s for page four onwards, %4$s for up to page three). Leaving this empty passes through."
msgstr "Separati da virgola. Accetta singole pagine (%1$s), intervalli (%2$s) e intervalli aperti (%3$s a partire dalla pagina quattro, %4$s fino alla pagina tre inclusa). Se lasciato vuoto, il valore viene trasmesso così com’è."
