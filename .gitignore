# WordPress Plugin .gitignore

# Dependencies
/vendor/
/node_modules/

# IDE & Editor Files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.code-workspace

# OS Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Build & Compiled Files
/build/
/dist/
*.min.js
*.min.css
*.map

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
error_log

# Environment & Config
.env
.env.local
.env.*.local
wp-config-local.php

# Sample & Test Data
/sample-data/

# Temporary Files
*.tmp
*.temp
*.swp
*.swo
*.bak
*.cache

# PHPUnit
/tmp/
/tests/tmp/

# Composer
composer.lock
composer.phar

# NPM
package-lock.json
yarn.lock

# WordPress
.htaccess
*.zip
*.tar.gz

# Claude Code per-machine settings
.claude/settings.local.json

# Private development notes. Never published: may contain client site names and
# unredacted diagnostics. Blocked from remote access by dev-notes/.htaccess.
dev-notes/

# External code-analysis results, written by OpenAI Codex. Never published: a report
# may describe an unfixed vulnerability. Blocked by code-analysis/.htaccess.
code-analysis/

# Emacs: Projectile project marker, backup, lock and auto-save files
.projectile
*~
.#*
\#*#
